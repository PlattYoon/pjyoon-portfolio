/*
 * Text buffers
 *
 * The back end for a one-character text editor, a doubly-linked list
 * whose elements are 16-character gap buffers.
 *
 * 15-122 Principles of Imperative Computation */

/*** Interface (DO NOT CHANGE) ***/

typedef dll_pt tbuf;

bool is_tbuf(tbuf* B);

tbuf* tbuf_new();                  /* Creates an empty text buffer with   */
                                   /* gap buffers of size 16              */
void tbuf_split_pt(tbuf* B);       /* Splits a full point into two nodes  */
                                   /* so that the new point is not full   */
void tbuf_forward(tbuf* B);        /* Move the cursor forward/right by 1  */
void tbuf_backward(tbuf* B);       /* Move the cursor backward/left by 1  */
void tbuf_insert(tbuf* B, char c); /* Insert c before the cursor          */
void tbuf_delete(tbuf* B);         /* Delete the char before the cursor   */
                                   /* and delete point if it is empty     */

/*** Implementation (include contracts here) ***/

bool all_gapbufs_size_16(dll* start, dll* end)
//@requires start != NULL && end != NULL;
{
  dll* current = start->next; 
  while (current != end)
  //@loop_invariant current != NULL;
  {
    if (current == NULL) return false;
    if (current->data == NULL) return false;
    if (!is_gapbuf(current->data)) return false;
    if (current->data->limit != 16) return false;
    current = current->next;
  }
  return true;
}

bool is_aligned(tbuf* B)
//@requires B != NULL;
//@requires is_dll_pt(B);
{
  dll* current;
  
  current = B->start->next; 
  while (current != B->point)
  //@loop_invariant current != NULL;
  {
    if (current == NULL) return false;
    if (current->data == NULL) return false;
    if (!is_gapbuf(current->data)) return false;
    if (!gapbuf_at_right(current->data)) return false;
    current = current->next;
  }
  
  
  current = B->point->next;
  while (current != B->end)
  //@loop_invariant current != NULL;
  {
    if (current == NULL) return false;
    if (current->data == NULL) return false;
    if (!is_gapbuf(current->data)) return false;
    if (!gapbuf_at_left(current->data)) return false;
    current = current->next;
  }
  
  return true;
}

bool valid_emptiness(tbuf* B)
//@requires B != NULL;
//@requires is_dll_pt(B);
{
  dll* current = B->start->next;
  int node_count = 0;
  bool has_empty = false;
  
  while (current != B->end)
  //@loop_invariant current != NULL;
  //@loop_invariant node_count >= 0;
  {
    if (current == NULL) return false;
    if (current->data == NULL) return false;
    if (!is_gapbuf(current->data)) return false;
    
    node_count++;
    if (gapbuf_empty(current->data)) {
      has_empty = true;
    }
    current = current->next;
  }
  
  if (has_empty && node_count != 1) return false;
  
  return true;
}

bool is_tbuf(tbuf* B)
{
  if (!is_dll_pt(B)) return false;

  if (!all_gapbufs_size_16(B->start, B->end)) return false;
  
  if (!is_aligned(B)) return false;
  
  if (!valid_emptiness(B)) return false;
  
  return true;
}

tbuf* tbuf_new()
//@ensures is_tbuf(\result);
//@ensures \result != NULL;
//@ensures gapbuf_empty(\result->point->data);
//@ensures \result->point->data->limit == 16;
{
  tbuf* B = alloc(struct dll_pt_header);
  //@assert B != NULL;
  
  B->start = alloc(struct dll_node);
  B->end = alloc(struct dll_node);
  //@assert B->start != NULL && B->end != NULL;
  
  dll* data_node = alloc(struct dll_node);
  //@assert data_node != NULL;
  data_node->data = gapbuf_new(16);
  //@assert gapbuf_empty(data_node->data);
  
  B->start->next = data_node;
  B->start->prev = NULL;
  B->start->data = NULL; 
  
  data_node->prev = B->start;
  data_node->next = B->end;
  
  B->end->prev = data_node;
  B->end->next = NULL;
  B->end->data = NULL; 
  
  B->point = data_node;
  
  //@assert B->point != B->start && B->point != B->end;
  
  return B;
}

/* Task 9: Split a full point into two nodes */

void split_gapbuf(gapbuf* source_buf, gapbuf* first_half, gapbuf* second_half)
//@requires gapbuf_full(source_buf);
//@requires gapbuf_empty(first_half) && gapbuf_empty(second_half);
/*@requires source_buf->limit == 16 && 
            first_half->limit == 16 &&
             second_half->limit == 16;@*/
//@ensures is_gapbuf(first_half) && is_gapbuf(second_half);
{
  //@assert source_buf != NULL && first_half != NULL && second_half != NULL;
  //@assert source_buf->gap_start == source_buf->gap_end; // buffer is full
  //@assert source_buf->limit == 16;
  
  int gap_position = source_buf->gap_start;
  //@assert 0 <= gap_position && gap_position <= 16;
  
  if (gap_position <= 7) {
    first_half->gap_start = gap_position;
    first_half->gap_end = gap_position + 8;
    //@assert first_half->gap_start <= first_half->gap_end;
    
    for (int i = 0; i < gap_position; i++)
      //@loop_invariant 0 <= i && i <= gap_position;
    {
      first_half->buffer[i] = source_buf->buffer[i];
    }
    
    int chars_after_gap = 8 - source_buf->gap_end;
    for (int j = 0; j < chars_after_gap; j++)
      //@loop_invariant 0 <= j && j <= chars_after_gap;
    {
      first_half->buffer[first_half->gap_end + j] = 
                         source_buf->buffer[gap_position + j];
    }

    second_half->gap_start = 0;
    second_half->gap_end = 8;
    
    for (int k = 8; k < 16; k++)
      //@loop_invariant 8 <= k && k <= 16;
    {
      second_half->buffer[k] = source_buf->buffer[k];
    }
    
    //@assert gapbuf_at_left(second_half);
  }
  else {
    //@assert gap_position >= 8;
    
    first_half->gap_start = 8;
    first_half->gap_end = 16;
    
    for (int m = 0; m < 8; m++)
      //@loop_invariant 0 <= m && m <= 8;
    {
      first_half->buffer[m] = source_buf->buffer[m];
    }
    //@assert gapbuf_at_right(first_half);

    second_half->gap_start = gap_position - 8;
    second_half->gap_end = second_half->gap_start + 8;
    //@assert second_half->gap_start <= second_half->gap_end;
    
    int chars_before_gap = gap_position - 8;
    for (int n = 0; n < chars_before_gap; n++)
      //@loop_invariant 0 <= n && n <= chars_before_gap;
    {
      second_half->buffer[n] = source_buf->buffer[8 + n];
    }
    
    int chars_after_gap_second = 16 - gap_position;
    for (int p = 0; p < chars_after_gap_second; p++)
      //@loop_invariant 0 <= p && p <= chars_after_gap_second;
    {
      second_half->buffer[second_half->gap_end + p] = 
        source_buf->buffer[source_buf->gap_end + p];
    }
  }
  
  //@assert is_gapbuf(first_half) && is_gapbuf(second_half);
}

void tbuf_split_pt(tbuf* B)
//@requires is_tbuf(B);
//@requires gapbuf_full(B->point->data);
//@ensures is_tbuf(B);
{
  //@assert B->point != NULL && is_gapbuf(B->point->data);
  //@assert gapbuf_full(B->point->data);
  
  gapbuf* beginning_gapbuf = gapbuf_new(16);
  gapbuf* ending_gapbuf = gapbuf_new(16);
  //@assert beginning_gapbuf != NULL && ending_gapbuf != NULL;
  //@assert gapbuf_empty(beginning_gapbuf) && gapbuf_empty(ending_gapbuf);
  
  dll* current_node = B->point;
  gapbuf* current_gapbuf = current_node->data;
  split_gapbuf(current_gapbuf, beginning_gapbuf, ending_gapbuf);

  dll* beginning_node = alloc(dll);
  dll* ending_node = alloc(dll);

  //@assert beginning_node != NULL && ending_node != NULL;
  beginning_node ->data = beginning_gapbuf;
  ending_node->data = ending_gapbuf;

  beginning_node->next = ending_node;
  ending_node->prev = beginning_node;
  
  beginning_node->prev = current_node->prev;
  ending_node->next = current_node->next;
  //@assert beginning_node->prev != NULL && ending_node->next != NULL;
  
  current_node->prev->next = beginning_node;
  current_node->next->prev = ending_node;

  if (gapbuf_at_left(ending_node->data)) {
    B->point = beginning_node;
  } else {
    B->point = ending_node;
  }
}


void tbuf_forward(tbuf* B)
//@requires is_tbuf(B);
//@requires B != NULL;
//@ensures is_tbuf(B);
{
  //@assert B->point != NULL && is_gapbuf(B->point->data);
  
  gapbuf* current_buf = B->point->data;
  //@assert is_gapbuf(current_buf);
  
  if (!gapbuf_at_right(current_buf)) {
    //@assert !gapbuf_at_right(current_buf);
    gapbuf_forward(current_buf);
    return;
  }
  else {
    if (B->point->next == B->end){
        return;
    }
    //@assert gapbuf_at_left(B->point->next->data);
    B->point = B->point->next;
    gapbuf_forward(B->point->data);
  }
}

void tbuf_backward(tbuf* B)
//@requires is_tbuf(B);
//@requires B != NULL;
//@ensures is_tbuf(B);
{
  //@assert B->point != NULL && is_gapbuf(B->point->data);
  gapbuf* current_buf = B->point->data;
  //@assert is_gapbuf(current_buf);
  
  if (!gapbuf_at_left(current_buf)) {
    //@assert !gapbuf_at_left(current_buf); 
    gapbuf_backward(current_buf);
    return;
  }
  else{
    if(B->point->prev == B->start){
        return;
    }
    //@assert gapbuf_at_right(B->point->prev->data);
    B->point = B->point->prev;
    gapbuf_backward(B->point->data);
    return;
  }
}

void tbuf_insert(tbuf* B, char c)
//@requires B != NULL;
//@requires is_tbuf(B);
//@requires !gapbuf_full(B->point->data);
//@ensures is_tbuf(B);
{
  //@assert B->point != NULL && is_gapbuf(B->point->data);
  
  gapbuf* current_buf = B->point->data;
  //@assert is_gapbuf(current_buf);
  gapbuf_insert(current_buf, c);
  
  if (gapbuf_full(current_buf)) {
    //@assert gapbuf_full(current_buf);
    tbuf_split_pt(B);
    return;
  }
  return;
}



void tbuf_delete(tbuf* text_buffer)
//@requires is_tbuf(text_buffer);
//@ensures is_tbuf(text_buffer);
{
  //@assert text_buffer != NULL;
  //@assert text_buffer->point != NULL && is_gapbuf(text_buffer->point->data);
  
  gapbuf* current_gapbuf = text_buffer->point->data;
  //@assert is_gapbuf(current_gapbuf);
  
  bool at_beginning = gapbuf_at_left(current_gapbuf) && 
                     (text_buffer->point->prev == text_buffer->start);
  
  if (at_beginning) {
    //@assert is_tbuf(text_buffer);
    return;
  }
  
  if (gapbuf_at_left(current_gapbuf)) {
    //@assert text_buffer->point->prev != text_buffer->start;
    dll* previous_node = text_buffer->point->prev;
    //@assert previous_node != NULL && previous_node != text_buffer->start;
    //@assert is_gapbuf(previous_node->data);
    //@assert gapbuf_at_right(previous_node->data); 
    
    text_buffer->point = previous_node;
    current_gapbuf = text_buffer->point->data;
    //@assert is_gapbuf(current_gapbuf);
  }
  
  //@assert !gapbuf_at_left(current_gapbuf);
  gapbuf_delete(current_gapbuf);
  //@assert is_gapbuf(current_gapbuf);
  
  bool buffer_is_empty = gapbuf_empty(current_gapbuf);
  
  bool is_only_buffer = (text_buffer->start->next == text_buffer->point) && 
                       (text_buffer->point->next == text_buffer->end) && 
                       gapbuf_empty(text_buffer->point->data);
  //@assert text_buffer->start != NULL && text_buffer->end != NULL;
  //@assert text_buffer->point != NULL;
  
  if (buffer_is_empty && !is_only_buffer) {
    //@assert gapbuf_empty(current_gapbuf);
    //@assert !is_only_buffer;

    dll_pt_delete(text_buffer);
  }
  
}