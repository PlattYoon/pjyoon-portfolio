/*
 * Testing the text buffer implementation; instead of using a
 * doubly-linked list of gap buffers, uses a doubly-linked list of
 * chars.
 *
 * Note that this is just for testing! This code allows the user's
 * input to attempt removing things an empty buffer and moving left or
 * right off the end of the linked list. These should lead to a
 * @requires violation.
 *
 * cc0 -d -w -x elem-char.c0 dll_pt.c0 dll_pt-test.c0
 *
 * 15-122 Principles of Imperative Computation */

#use <conio>
#use <string>

void visualize_dll_pt(dll_pt* B)
{
  printf("START");
  for (dll* L = B->start->next; L != B->end; L = L->next) {
    printf(" <--> ");
    if (L == B->point) printf("_");
    printf("'%c'", L->data);
    if (L == B->point) printf("_");
  }
  printf(" <--> END\n");
}

dll_pt* construct_char_buffer(string s)
//@requires string_length(s) > 0;
//@ensures is_dll_pt(\result);
//@ensures dll_pt_at_right(\result);
{
  int limit = string_length(s);
  dll_pt* B = alloc(dll_pt);

  B->start = alloc(dll);

  dll* last = B->start;
  for(int i = 0; i < limit; i++)
    //@loop_invariant 0 <= i && i <= limit;
    {
      last->next = alloc(dll);
      last->next->prev = last;
      last->next->data = string_charat(s,i);
      last = last->next;
    }

  last->next = alloc(dll);
  last->next->prev = last;

  B->point = last;
  B->end = last->next;

  return B;
}

void process_char(dll_pt* B, char c)
{
  if (c == '<') {
    printf("<= : ");
    dll_pt_backward(B);
  } else if (c == '>') {
    printf("=> : ");
    dll_pt_forward(B);
  } else if (c == '^') {
    printf("del: ");
    dll_pt_delete(B);
  } else {
    error("This only supports '<' (left), '>' (right), and '^' (delete)");
  }
}

void process_string(dll_pt* B, string s)
{
  int limit = string_length(s);
  for(int i = 0; i < limit; i++) {
    process_char(B, string_charat(s, i));
    visualize_dll_pt(B);
  }
}

void test()
{
  printf("Visualizing the text buffer with elem as char.\n");
  printf("Give an initial input for the buffer (empty line quits): ");
  flush();

  string s = readline();
  if(string_equal("", s)) return;
  dll_pt* B = construct_char_buffer(s);

  printf("Initial buffer: ");
  visualize_dll_pt(B);
  printf("\nNow you can edit the buffer:\n");
  printf("The '<' character mimics going backwards (left arrow key)\n");
  printf("The '>' character mimics going forwards (right arrow key)\n");
  printf("The '^' character mimics deletion (delete key)\n\n");
  printf("Give actions (empty line quits): "); flush();
  s = readline();

  while(!string_equal("", s)) {
    printf("     ");
    visualize_dll_pt(B);
    process_string(B, s);
    printf("Done. More actions? (empty line quits): "); flush();
    s = readline();
  }
}

int main() {
  test();
  printf("Goodbye.\n");
  return 0;
}
