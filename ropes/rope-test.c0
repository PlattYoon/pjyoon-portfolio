#use <conio>

// You are welcome to define helper functions for your tests

// Helper function to test rope equality
bool test_rope_equal(rope_t R1, rope_t R2) {
  if (rope_length(R1) != rope_length(R2)) return false;
  if (rope_length(R1) == 0) return true;
  
  for (int i = 0; i < rope_length(R1); i++) {
    if (rope_charat(R1, i) != rope_charat(R2, i)) return false;
  }
  return true;
}

// Helper function to test string conversion
bool test_rope_string(rope_t R, string expected) {
  string actual = rope_tostring(R);
  return string_equal(actual, expected);
}

int main() {
  printf("Starting rope tests...\n");
  
  // Test 1: Basic rope creation and validation
  printf("Test 1: Basic rope creation\n");
  rope_t r1 = rope_new("hello");
  assert(is_rope(r1));
  assert(rope_length(r1) == 5);
  assert(test_rope_string(r1, "hello"));
  printf("✓ Basic creation passed\n");
  
  // Test 2: Empty rope handling
  printf("Test 2: Empty rope handling\n");
  rope_t empty = rope_new("");
  assert(empty == NULL);
  assert(is_rope(empty));
  assert(rope_length(empty) == 0);
  assert(test_rope_string(empty, ""));
  printf("✓ Empty rope passed\n");
  
  // Test 3: Simple rope joining
  printf("Test 3: Simple rope joining\n");
  rope_t r2 = rope_new("world");
  rope_t joined = rope_join(r1, r2);
  assert(is_rope(joined));
  assert(rope_length(joined) == 10);
  assert(test_rope_string(joined, "helloworld"));
  printf("✓ Simple joining passed\n");
  
  // Test 4: Character access
  printf("Test 4: Character access\n");
  assert(rope_charat(joined, 0) == 'h');
  assert(rope_charat(joined, 4) == 'o');
  assert(rope_charat(joined, 5) == 'w');
  assert(rope_charat(joined, 9) == 'd');
  printf("✓ Character access passed\n");
  
  // Test 5: Complex joining (from assignment example)
  printf("Test 5: Complex joining - 'happy birthday!'\n");
  rope_t happy = rope_new("happ");
  rope_t y_birth = rope_new("y birth");
  rope_t day = rope_new("day!");
  rope_t happy_birth = rope_join(happy, y_birth);
  rope_t birthday = rope_join(happy_birth, day);
  assert(is_rope(birthday));
  assert(rope_length(birthday) == 15);
  assert(test_rope_string(birthday, "happy birthday!"));
  printf("✓ Complex joining passed\n");
  
  // Test 6: Substring operations - entire rope
  printf("Test 6: Substring - entire rope\n");
  rope_t sub_entire = rope_sub(birthday, 0, 15);
  assert(sub_entire == birthday); // Should return same rope
  assert(test_rope_string(sub_entire, "happy birthday!"));
  printf("✓ Entire substring passed\n");
  
  // Test 7: Substring operations - partial
  printf("Test 7: Substring - partial segments\n");
  rope_t sub_happy = rope_sub(birthday, 0, 5);
  assert(test_rope_string(sub_happy, "happy"));
  
  rope_t sub_birth = rope_sub(birthday, 6, 11);
  assert(test_rope_string(sub_birth, "birth"));
  
  rope_t sub_day = rope_sub(birthday, 11, 15);
  assert(test_rope_string(sub_day, "day!"));
  printf("✓ Partial substrings passed\n");
  
  // Test 8: Substring spanning children
  printf("Test 8: Substring spanning children\n");
  rope_t sub_span = rope_sub(birthday, 3, 9);
  assert(test_rope_string(sub_span, "py bir"));
  printf("✓ Spanning substring passed\n");
  
  // Test 9: Edge case substrings
  printf("Test 9: Edge case substrings\n");
  rope_t sub_empty = rope_sub(birthday, 5, 5);
  assert(sub_empty == NULL);
  assert(rope_length(sub_empty) == 0);
  
  rope_t sub_one = rope_sub(birthday, 0, 1);
  assert(test_rope_string(sub_one, "h"));
  
  rope_t sub_last = rope_sub(birthday, 14, 15);
  assert(test_rope_string(sub_last, "!"));
  printf("✓ Edge case substrings passed\n");
  
  // Test 10: Joining with NULL ropes
  printf("Test 10: Joining with NULL\n");
  rope_t null_rope = NULL;
  rope_t join_null_left = rope_join(null_rope, r1);
  assert(join_null_left == r1);
  
  rope_t join_null_right = rope_join(r1, null_rope);
  assert(join_null_right == r1);
  
  rope_t join_both_null = rope_join(null_rope, null_rope);
  assert(join_both_null == NULL);
  printf("✓ NULL joining passed\n");
  
  // Test 12: Complex structure from assignment
  printf("Test 12: Assignment example - 'totallyefficient'\n");
  rope_t totally = rope_new("totally");
  rope_t efficient = rope_new("efficient");
  rope_t totally_efficient = rope_join(totally, efficient);
  
  assert(rope_length(totally_efficient) == 16);
  assert(test_rope_string(totally_efficient, "totallyefficient"));
  
  // Test substrings as mentioned in assignment
  rope_t sub1 = rope_sub(totally_efficient, 1, 16); // "otallyefficient"
  assert(test_rope_string(sub1, "otallyefficient"));
  
  rope_t sub2 = rope_sub(totally_efficient, 1, 11); // "otallyeffi"
  assert(test_rope_string(sub2, "otallyeffi"));
  
  rope_t sub3 = rope_sub(totally_efficient, 2, 11); // "tallyeffi"
  assert(test_rope_string(sub3, "tallyeffi"));
  
  rope_t sub4 = rope_sub(totally_efficient, 0, 1); // "t"
  assert(test_rope_string(sub4, "t"));
  
  rope_t sub5 = rope_sub(totally_efficient, 7, 16); // "efficient"
  assert(test_rope_string(sub5, "efficient"));
  printf("✓ Assignment example passed\n");
  
  // Test 13: Data structure invariant on invalid ropes
  printf("Test 13: Invalid rope detection\n");
  
  // Test with manually created invalid rope (one child NULL)
  rope_t invalid = alloc(struct rope_node);
  invalid->len = 5;
  invalid->left = rope_new("hello");
  invalid->right = NULL;
  invalid->data = "";
  assert(!is_rope(invalid)); // Should be invalid
  printf("✓ Invalid rope detection passed\n");
  
  // Test 14: Large string operations
  printf("Test 14: Larger string operations\n");
  rope_t part1 = rope_new("The quick brown fox ");
  rope_t part2 = rope_new("jumps over the ");
  rope_t part3 = rope_new("lazy dog.");
  
  rope_t sentence = rope_join(rope_join(part1, part2), part3);
  assert(rope_length(sentence) == 44);
  assert(rope_charat(sentence, 0) == 'T');
  assert(rope_charat(sentence, 43) == '.');
  assert(rope_charat(sentence, 20) == 'j'); // Start of "jumps"
  
  rope_t quick_brown = rope_sub(sentence, 4, 15);
  assert(test_rope_string(quick_brown, "quick brown"));
  printf("Large string operations passed\n");
  
  printf("All tests passed!\n");
  return 0;
}