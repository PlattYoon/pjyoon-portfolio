#use <conio>
#use <string>
#use <util>

/************************************************************************/
/**************** BEGIN IMPLEMENTATION (edit this part) *****************/

typedef struct rope_node rope;
struct rope_node {
  int len;
  rope* left;
  rope* right;
  string data;
};


// Forward declaration (do not edit)
void rope_print(rope* R);

/* Include your code between HERE ... */

bool is_rope(rope* R) {
  if (R == NULL) return true;
  rope* slow = R; rope* fast = R;
  while (fast != NULL && fast->left != NULL) {
    slow = slow->left; fast = fast->left->left;
    if (slow == fast) return false;
  }
  if (R->left == NULL && R->right == NULL) {
    return string_length(R->data) > 0 && 
           R->len == string_length(R->data);
  }
  if (R->left != NULL && R->right != NULL) {
    return is_rope(R->left) && 
           is_rope(R->right) &&
           R->len == R->left->len + R->right->len;
  }
  return false;
}

void rope_print(rope* R) {
  if (R == NULL) {
    printf("NULL");
    return;
  }
  if (R->left == NULL && R->right == NULL) {
    printf("\"%s\"", R->data);
  } else {
    printf("(");
    rope_print(R->left);
    printf(" + ");
    rope_print(R->right);
    printf(")");
  }
}

typedef rope* rope_t;

int rope_length(rope_t R)
//@ensures \result >= 0;
{
  if (R == NULL) return 0;
  return R->len;
}

rope_t rope_new(string s)
//@ensures rope_length(\result) == string_length(s);
{
  if (string_length(s) == 0) {
    return NULL;
  }
  rope_t R = alloc(struct rope_node);
  R->data = s;
  R->len = string_length(s);
  R->left = NULL;
  R->right = NULL;
  
  return R;
}

rope_t rope_join(rope_t R, rope_t S)
//@requires rope_length(R) <= int_max() - rope_length(S);
//@ensures rope_length(\result) == rope_length(R) + rope_length(S);
{
  if (R == NULL) return S;
  if (S == NULL) return R;
  
  rope_t T = alloc(rope);
  T->left = R;
  T->right = S;
  T->len = R->len + S->len;
  T->data = ""; 
  
  return T;
}

char rope_charat(rope_t R, int i)
//@requires 0 <= i && i < rope_length(R);
{
  //@assert(R != NULL);
  if (R->left == NULL && R->right == NULL) {
    return string_charat(R->data, i);
  }
  if (i < R->left->len) {
    return rope_charat(R->left, i);
  } else {
    return rope_charat(R->right, i - R->left->len);
  }
}

string rope_tostring(rope_t R)
//@ensures string_length(\result) == rope_length(R);
{
  if (R == NULL) {
    return "";
  }
  if (R->left == NULL && R->right == NULL) {
    return R->data;
  }
  string left_str = rope_tostring(R->left);
  string right_str = rope_tostring(R->right);
  return string_join(left_str, right_str);
}

rope_t rope_sub(rope_t R, int lo, int hi)
//@requires 0 <= lo && lo <= hi && hi <= rope_length(R);
//@ensures rope_length(\result) == hi - lo;
{
  if (lo == hi) {
    return NULL;
  }
  if (R == NULL) {
    return NULL;
  }
  if (lo == 0 && hi == R->len) {
    return R;
  }
    if (R->left == NULL && R->right == NULL) {
    string part = string_sub(R->data, lo, hi);
    return rope_new(part);
  }
  int splits = R->left->len;
  if (hi <= splits) {
    return rope_sub(R->left, lo, hi);
  }
  
  if (lo >= splits) {
    return rope_sub(R->right, lo - splits, hi - splits);
  }
  
  rope_t left_part = rope_sub(R->left, lo, splits);
  rope_t right_part = rope_sub(R->right, 0, hi - splits);
  return rope_join(left_part, right_part);
}


key entry_key(entry x) {
  return x;
}

int rope_hash(key k) {
  rope_t R = (rope_t)k;
  if (R == NULL) return 0;
  int len = rope_length(R);
  int hash = len;
  if (len > 0) {
    hash = hash * 31 + char_ord(rope_charat(R, 0));
    hash = hash * 31 + char_ord(rope_charat(R, len - 1));
  }
  if (len > 2) {
    hash = hash * 31 + char_ord(rope_charat(R, len / 2));
  }
  if (len > 6) {
    hash = hash * 31 + char_ord(rope_charat(R, len / 4));
    hash = hash * 31 + char_ord(rope_charat(R, 3 * len / 4));
  }
  return abs(hash);
}

bool rope_equiv(key k1, key k2) {
  rope_t R1 = (rope_t)k1;
  rope_t R2 = (rope_t)k2;
  
  if (R1 == NULL && R2 == NULL) return true;
  if (R1 == NULL || R2 == NULL) return false;
  if (R1 == R2) return true; 
  
  string s1 = rope_tostring(R1);
  string s2 = rope_tostring(R2);
  return string_equal(s1, s2);
}

rope_t reduce_rope_helper(rope_t R, hdict_t dict) {
  if (R == NULL) return NULL;
  rope_t found = (rope_t)hdict_lookup(dict, (key)R);
  if (found != NULL) {
    return found;
  }
  
  if (R->left != NULL && R->right != NULL) {
    rope_t new_left = reduce_rope_helper(R->left, dict);
    rope_t new_right = reduce_rope_helper(R->right, dict);
    R->left = new_left;
    R->right = new_right;
  }
  
  hdict_insert(dict, (entry)R);
  
  return R;
}

void rope_reduce(rope_t[] A, int n) 
//@requires n == \length(A);
{
  if (n == 0) return;
  
  hdict_t dict = hdict_new(n * 4, &entry_key, &rope_hash, &rope_equiv);
  
  for (int i = 0; i < n; i++) {
    if (A[i] != NULL) {
      A[i] = reduce_rope_helper(A[i], dict);
    }
  }
}

