/*
 * Clac, stack-based calculator language
 *
 * 15-122 Principles of Imperative Computation
 */

#use <string>
#use <parse>
#use <conio>
#use <args>
#use <util>


/* From the perspective of the clac-main.c0 file, state_t is an
 * abstract type. (typedef ____* state_t) This file contains the
 * implementation of the state_t type. You will need to modify
 * this type when you do task 3. */

struct clac_state {
  dict_t definitions;
  qstack_t return_stack;  
};
typedef struct clac_state* state_t; 

state_t init_state()
//@ensures \result != NULL;
//@ensures \result -> definitions != NULL;
//@ensures \result -> return_stack != NULL;
{
  state_t ST = alloc(struct clac_state);
  ST->definitions = dict_new();
  ST->return_stack = qstack_new();
  return ST;
}



/* Main clac interpreter. */
/* Return true: clac top-level interpreter will expect more input */
/* Return false: clac top-level interpreter will exit */
bool eval(queue_t inputQ, stack_t S, state_t ST)
//@requires inputQ != NULL && S != NULL && ST != NULL;
//@requires ST -> definitions != NULL && ST -> return_stack != NULL;
//@ensures \result == false || queue_empty(inputQ);
{
  queue_t Q = inputQ;

  while (!queue_empty(Q) || !qstack_empty(ST->return_stack)) 
  //@loop_invariant Q != NULL && S != NULL && ST != NULL;
  //@loop_invariant ST->definitions != NULL && ST->return_stack != NULL;
  {
    if (queue_empty(Q) && !qstack_empty(ST->return_stack)) {
      Q = qpop(ST->return_stack);
      //@assert Q != NULL;
    }
    
    if (!queue_empty(Q)) {
      string tok = deq(Q); /* This dequeue is safe because we checked !queue_empty(Q) */
    // Uncommenting these lines might help with debugging:
    // printf("Read: %s\n", tok);
    
    if (string_equal(tok, ":")) {
      // Start definition
      if (queue_empty(Q)) {
        error(": name expected");
      }
      string name = deq(Q);
      
      queue_t def_queue = queue_new();
      
      bool found_semicolon = false;
      while (!queue_empty(Q) && !found_semicolon) {
        string def_tok = deq(Q);
        if (string_equal(def_tok, ";")) {
          found_semicolon = true;
        } else {
          enq(def_queue, def_tok);
        }
      }
      
      if (!found_semicolon) {
        error(": semicolon expected");
      }
      
      dict_insert(ST->definitions, name, def_queue);
      
    } else if (string_equal(tok, "print")) {
      if (stack_empty(S)) {
        error("print: stack empty");
      }
      int x = pop(S); /* This line is now safe because we checked stack_empty(S) */
      printf("%d\n", x);
    } else if (string_equal(tok, "quit")) {
      return false;
    } else if (string_equal(tok, "+")) {
      if (stack_empty(S)) {
        error("+: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("+: stack empty");
      }
      int x = pop(S);
      push(S, x + y);
    } else if (string_equal(tok, "-")) {
      if (stack_empty(S)) {
        error("-: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("-: stack empty");
      }
      int x = pop(S);
      push(S, x - y);
    } else if (string_equal(tok, "*")) {
      if (stack_empty(S)) {
        error("*: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("*: stack empty");
      }
      int x = pop(S);
      push(S, x * y);
    } else if (string_equal(tok, "/")) {
      if (stack_empty(S)) {
        error("/: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("/: stack empty");
      }
      int x = pop(S);
      if (y == 0) {
        error("/: division by zero");
      }
      if (x == int_min() && y == -1) {
        error("/: division overflow");
      }
      push(S, x / y);
    } else if (string_equal(tok, "%")) {
      if (stack_empty(S)) {
        error("%: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("%: stack empty");
      }
      int x = pop(S);
      if (y == 0) {
        error("%: modulus by zero");
      }
      if (x == int_min() && y == -1) {
        error("%: modulus overflow");
      }
      push(S, x % y);
    } else if (string_equal(tok, "**")) {
      if (stack_empty(S)) {
        error("**: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("**: stack empty");
      }
      int x = pop(S);
      if (y < 0) {
        error("**: negative exponent");
      }
      
      // Calculate x^y
      int result = 1;
      int i = 0;
      while (i < y) 
      //@loop_invariant 0 <= i && i <= y;
      {
        result = result * x;
        i = i + 1;
      }
      push(S, result);
    } else if (string_equal(tok, "<")) {
      if (stack_empty(S)) {
        error("<: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("<: stack empty");
      }
      int x = pop(S);
      if (x < y) {
        push(S, 1);
      } else {
        push(S, 0);
      }
    } else if (string_equal(tok, "drop")) {
      if (stack_empty(S)) {
        error("drop: stack empty");
      }
      pop(S); 
    } else if (string_equal(tok, "swap")) {
      if (stack_empty(S)) {
        error("swap: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("swap: stack empty");
      }
      int x = pop(S);
      push(S, y);
      push(S, x); 
    } else if (string_equal(tok, "rot")) {
      if (stack_empty(S)) {
        error("rot: stack empty");
      }
      int z = pop(S);
      if (stack_empty(S)) {
        error("rot: stack empty");
      }
      int y = pop(S);
      if (stack_empty(S)) {
        error("rot: stack empty");
      }
      int x = pop(S);
      push(S, y); 
      push(S, z); 
      push(S, x); 
    } else if (string_equal(tok, "if")) {
      if (stack_empty(S)) {
        error("if: stack empty");
      }
      int x = pop(S);
      if (x == 0) {
        int tokens_to_skip = 3;
        int i = 0;
        while (i < tokens_to_skip) 
        //@loop_invariant 0 <= i && i <= tokens_to_skip;
        {
          if (queue_empty(Q)) {
            error("if: not enough tokens to skip");
          }
          deq(Q);
          i = i + 1;
        }
      }
    } else if (string_equal(tok, "pick")) {
      if (stack_empty(S)) {
        error("pick: stack empty");
      }
      int n = pop(S);
      if (n <= 0) {
        error("pick: argument must be strictly positive");
      }
      
      int[] temp_array = alloc_array(int, n);
      
      int i = 0;
      while (i < n) 
      //@loop_invariant 0 <= i && i <= n;
      {
        if (stack_empty(S)) {
          error("pick: not enough elements on stack");
        }
        temp_array[i] = pop(S);
        i = i + 1;
      }
      
      int nth_element = temp_array[n-1];
      
      i = n - 1;
      while (i >= 0) 
      //@loop_invariant -1 <= i && i < n;
      {
        push(S, temp_array[i]);
        i = i - 1;
      }
      
      push(S, nth_element);
    } else if (string_equal(tok, "skip")) {
      if (stack_empty(S)) {
        error("skip: stack empty");
      }
      int n = pop(S);
      if (n < 0) {
        error("skip: argument must be non-negative");
      }
      
      int i = 0;
      while (i < n) 
      //@loop_invariant 0 <= i && i <= n;
      {
        if (queue_empty(Q)) {
          error("skip: not enough tokens to skip");
        }
        deq(Q); 
        i = i + 1;
      }
    } else {
      queue_t def = dict_lookup(ST->definitions, tok);
      if (def != NULL) {
        if (!queue_empty(Q)) {
          qpush(ST->return_stack, Q);
        }
        Q = queue_read_only_copy(def); 
      } else {
        /* Not defined as an operation name, should be an int */
        int* p = parse_int(tok, 10);
        if (p == NULL) { /* not an int */
          /* call error(msg) which prints msg and aborts */
          error(string_join("undefined token ", tok));
        }
        push(S, *p);
      }
    }
    }
  }

  /* When you return "true", don't pop anything off the stack! When we
   * grade your function, we'll check that the stack contains the
   * integers we expect. */
  return true;
}