# --- Model backend ----------------------------------------------------------
# Pick ONE mode. See docs/ARCHITECTURE.md §6.

# API mode (fastest to stand up; data leaves the machine)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local mode (self-hosted Qwen3 / Llama via vLLM; nothing leaves the machine)
# Point this at your vLLM OpenAI-compatible endpoint.
MODEL_BASE_URL=            # e.g. http://localhost:8000/v1
MODEL_NAME=               # e.g. Qwen3-32B-AWQ  or  meta-llama/Llama-3.1-8B-Instruct

# --- Jupyter dev server -----------------------------------------------------
JUPYTER_TOKEN=ida-dev
JUPYTER_PORT=8888

# --- IDA behavior -----------------------------------------------------------
# Master switch for proactive (unsolicited) messages. Start OFF for testing.
IDA_PROACTIVE_ENABLED=false
# Minimum seconds between two proactive messages (rate limit / anti-nag).
IDA_MIN_MESSAGE_INTERVAL_SEC=600
